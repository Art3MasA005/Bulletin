<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash and it cannot be turned off.
         Plain brand orange with no icon makes it indistinguishable from the
         first frame of the app's own splash, so the app appears to open
         straight onto the panda. The same in light and dark: the splash is
         orange either way. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
