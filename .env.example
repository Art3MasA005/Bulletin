# ── Bulletin backend configuration ───────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. NEVER ship any of these to the
# Flutter client — see CLAUDE.md warning #1.

# OpenRouter -----------------------------------------------------------------
BULLETIN_OPENROUTER_API_KEY=
BULLETIN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model IDs are intentionally left blank. Pick current ones from
# https://openrouter.ai/models and paste them here. A stale hardcoded default
# fails at request time with a confusing 400, so the code refuses to guess.
BULLETIN_VISION_MODEL=
BULLETIN_GENERATION_MODEL=
BULLETIN_EXTRACTION_MODEL=
BULLETIN_EMBEDDING_MODEL=

# Attempts per OpenRouter request, including the first (backoff on 429/5xx).
BULLETIN_PROVIDER_MAX_RETRIES=4

# Sent as HTTP-Referer / X-Title on OpenRouter requests (attribution only).
BULLETIN_APP_URL=https://github.com/yourname/bulletin
BULLETIN_APP_NAME=Bulletin

# Supabase (Phase 1+) ---------------------------------------------------------
BULLETIN_SUPABASE_URL=
BULLETIN_SUPABASE_ANON_KEY=
BULLETIN_SUPABASE_SERVICE_KEY=
# Legacy HS256 projects only; leave empty to verify against the project JWKS.
BULLETIN_SUPABASE_JWT_SECRET=
BULLETIN_DATABASE_URL=

# Ingestion thresholds --------------------------------------------------------
BULLETIN_MAX_UPLOAD_MB=20
BULLETIN_MAX_PAGES=150
BULLETIN_MIN_EXTRACTED_CHARS=50
# Below this Bijoy-conversion confidence, escalate the page to a vision read.
BULLETIN_BIJOY_CONFIDENCE_FLOOR=0.75
# Below this text-layer quality score, escalate a native_text page to vision.
# Prose notices score 0.92-1.00; scanned routine tables 0.53-0.82.
BULLETIN_OCR_QUALITY_FLOOR=0.90
# Below this fraction of expected chars/page, treat the page as scanned.
BULLETIN_SCANNED_CHARS_PER_PAGE=60
BULLETIN_VISION_RENDER_DPI=200

# Chunking (PRD §7.1) ---------------------------------------------------------
BULLETIN_CHUNK_TOKENS_EN=600
BULLETIN_CHUNK_CHARS_BN=1200
BULLETIN_CHUNK_OVERLAP_RATIO=0.15

# Retrieval (Phase 1) ---------------------------------------------------------
BULLETIN_EMBEDDING_DIM=1024
# 0.45 measured on the real corpus (eval/reports/score_floor_probe.md).
# Re-tune against the gold set: the two populations overlap by 0.01.
BULLETIN_RETRIEVAL_SCORE_FLOOR=0.48
BULLETIN_RETRIEVE_TOP_K=20
BULLETIN_RERANK_TOP_K=5

# Limits (PRD §10) ------------------------------------------------------------
BULLETIN_QUESTIONS_PER_DAY=50
BULLETIN_DOCUMENTS_PER_INSTITUTION=200

# Attachments (PRD §8.5) ------------------------------------------------------
BULLETIN_ATTACHMENT_MAX_MB=10
BULLETIN_ATTACHMENTS_PER_CONVERSATION=3
BULLETIN_ATTACHMENT_QUESTIONS_PER_DAY=10
BULLETIN_ATTACHMENT_IMAGE_TTL_DAYS=7
# Max confirmed course codes joined in one question; each is a retrieval round trip.
BULLETIN_JOIN_MAX_CODES=12
# Any extracted field below this renders flagged for review (PRD §8.3).
BULLETIN_EXTRACTION_CONFIDENCE_FLOOR=0.9

# Paths -----------------------------------------------------------------------
BULLETIN_CORPUS_DIR=corpus
BULLETIN_REPORTS_DIR=eval/reports
