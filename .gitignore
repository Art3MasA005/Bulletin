# Secrets — never commit
.env
.env.*
!.env.example
*.key
service-account*.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Corpus and generated reports (large, and may contain personal data)
corpus/
!corpus/.gitkeep
eval/reports/*
!eval/reports/.gitkeep

# Flutter
app/.dart_tool/
app/build/
app/.flutter-plugins*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
